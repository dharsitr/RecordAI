{
  "expo": {
    "name": "RecordAI Companion",
    "slug": "recordai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f19"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RecordAI to access camera to capture lab notebook pages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RecordAI to access your photos to select lab notebook pages."
        }
      ]
    ]
  }
}
